# =============================================================================
# BusMate Environment Variables
# Copy to .env and fill values. Never commit real secrets.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Backend ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_SECRET_KEY=change-me-to-a-long-random-string

# --- OpenRouter (optional – AI features degrade gracefully) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LangSmith (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=busmate

# --- Embeddings / RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true
CHN_DEMO_SEED=true

# --- Payment simulation ---
PAYMENT_SIMULATION=true
OTP_SIMULATION=true
